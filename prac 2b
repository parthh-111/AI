j1_CAP = 4
j2_CAP = 3
TARGET = 2

def get_next_states(state):
    j1, j2 = state
    moves = []
    moves.append((j1_CAP, j2))
    moves.append((j1, j2_CAP))
    moves.append((0, j2))
    moves.append((j1, 0))
    pour_to_j2 = min(j1, j2_CAP - j2)
    moves.append((j1 - pour_to_j2, j2 + pour_to_j2))
    pour_to_j1 = min(j2, j1_CAP - j1)
    moves.append((j1 + pour_to_j1, j2 - pour_to_j1))

    return list(set(moves))


def solve_water_jug_dfs():
    stack = [((0, 0), [(0, 0)])]
    visited = {(0, 0)}

    while stack:
        (j1, j2), path = stack.pop()

        if j1 == TARGET or j2 == TARGET:
            return path

        for next_state in get_next_states((j1, j2)):
            if next_state not in visited:
                visited.add(next_state)
                stack.append((next_state, path + [next_state]))

    return None


solution = solve_water_jug_dfs()

if solution:
    print(f"Solution found using DFS ({len(solution)-1} steps):")
    for step, (j1, j2) in enumerate(solution):
        print(f"Step {step}: Jug 1 = {j1}L, Jug 2 = {j2}L")
else:
    print(f"It is impossible to get exactly {TARGET}L with these jugs.")
