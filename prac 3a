import heapq

goal = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)

goal_position = {}

for i, value in enumerate(goal):
    goal_position[value] = (i // 3, i % 3)


def find_distance(state):
    distance = 0

    for i, value in enumerate(state):
        if value != 0:
            current_row = i // 3
            current_col = i % 3

            goal_row, goal_col = goal_position[value]

            distance += abs(current_row - goal_row) + abs(current_col - goal_col)

    return distance


def next_states(state):
    states = []

    blank = state.index(0)
    row = blank // 3
    col = blank % 3

    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    for dr, dc in moves:
        new_row = row + dr
        new_col = col + dc

        if 0 <= new_row < 3 and 0 <= new_col < 3:
            new_blank = new_row * 3 + new_col

            temp = list(state)
            temp[blank], temp[new_blank] = temp[new_blank], temp[blank]

            states.append(tuple(temp))

    return states


def greedy_search(start):
    queue = []

    heapq.heappush(
        queue,
        (find_distance(start), start, [start])
    )

    visited = set()

    while queue:
        h, current, path = heapq.heappop(queue)

        if current == goal:
            return path

        if current not in visited:
            visited.add(current)

            for state in next_states(current):
                if state not in visited:
                    heapq.heappush(
                        queue,
                        (find_distance(state), state, path + [state])
                    )

    return None


def print_board(state):
    for i in range(0, 9, 3):
        print(state[i:i + 3])
    print()


start = (1, 2, 3,
         0, 4, 6,
         7, 5, 8)

print("Initial State")
print_board(start)

solution_path = greedy_search(start)

if solution_path:
    print("Solution Found")
    print("Total Moves:", len(solution_path) - 1)
    print()

    for i, state in enumerate(solution_path):
        print("Step", i)
        print_board(state)
else:
    print("No solution Found")
